# Never commit real values. Set these in the hosting provider's secret environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
META_VERIFY_TOKEN=generate-a-long-random-secret
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-system-user-token
META_GRAPH_VERSION=vXX.X
WEBHOOK_READ_TOKEN=generate-a-separate-long-random-secret
PAIRING_CODE=generate-a-one-time-random-code
PWA_ORIGIN=https://sasd23207-alt.github.io
PORT=10000
# Set true only when the PostgreSQL endpoint requires TLS with a trusted certificate.
PGSSL=false
